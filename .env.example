# ==============================================================================
# CF-PS-15 Data Lake Access Control Dashboard - Environment Configuration
# ==============================================================================
# Backblaze B2 S3-Compatible API Settings
B2_ENDPOINT_URL=
B2_REGION=

# Backblaze B2 Bucket Names (Must be distinct private buckets)
B2_RAW_BUCKET=
B2_CURATED_BUCKET=
B2_AUDIT_BUCKET=

# Processor Credentials: RAW Bucket Scoped (Read-only capabilities: listObjects, getObject)
B2_PROCESSOR_RAW_ACCESS_KEY_ID=
B2_PROCESSOR_RAW_SECRET_ACCESS_KEY=

# Processor Credentials: CURATED Bucket Scoped (Write capabilities: putObject, listObjects)
B2_PROCESSOR_CURATED_ACCESS_KEY_ID=
B2_PROCESSOR_CURATED_SECRET_ACCESS_KEY=

# Analyst Credentials: CURATED Bucket Scoped (Read-only capabilities: listObjects, getObject)
B2_ANALYST_CURATED_ACCESS_KEY_ID=
B2_ANALYST_CURATED_SECRET_ACCESS_KEY=

# Application Database & Security
DATABASE_URL=
SESSION_SECRET_KEY=
ADMIN_BOOTSTRAP_SECRET=

# Optional: Dedicated Admin / Setup Key for Initial Bucket Verification (if available)
B2_ADMIN_ACCESS_KEY_ID=
B2_ADMIN_SECRET_ACCESS_KEY=

# Backend API URL for Streamlit Frontend
API_BASE_URL=
